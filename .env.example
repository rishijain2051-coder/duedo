# PRO-SYS — single Next.js app (UI + API routes together).
# Copy to .env for local dev; set the same keys in the Vercel project for production.

# --- Database ---
# SUPABASE: use the "Transaction pooler" string (port 6543) with sslmode=no-verify
#   (Supabase's pooler cert isn't in Node's default CA chain; traffic is still TLS).
#   URL-encode reserved characters in the password: # -> %23, & -> %26, % -> %25, @ -> %40.
#   A raw '#' silently truncates the URL, so double-check that one.
#   NOTE: run schema changes (prisma db push) against the SESSION pooler (port 5432) — see DEPLOY.md.
DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=no-verify&pgbouncer=true"

# --- Login sessions ---
# Signs the login session cookie. Any long random string. e.g. openssl rand -base64 48
# Changing this invalidates every existing login.
AUTH_SECRET="change-me-to-a-long-random-string"

# Shown in the UI and in email subjects. next.config.ts re-exports it as
# NEXT_PUBLIC_APP_NAME for the browser bundle, so set it here only.
APP_NAME="PRO-SYS"

# REQUIRED in production. Every confirmation link is built from this, and confirming
# the email is what activates an account — so if this is wrong or missing, links point
# at http://localhost:3000 and nobody can ever finish signing up. It is also the
# "Open PRO-SYS" button in reminder emails.
APP_URL="https://your-app.vercel.app"

# --- Email reminders (SMTP; optional — leave blank to skip emails) ---
# Gmail (your own account, free): enable 2-Step Verification, then create a 16-char
# App Password at https://myaccount.google.com/apppasswords
# Each user chooses in Settings whether they want email; this is just the sender.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="PRO-SYS <youraddress@gmail.com>"

# --- Push reminders (Web Push / VAPID; optional — leave blank to skip push) ---
# Generate a pair with:  npx web-push generate-vapid-keys
# The public key is intentionally exposed to the browser, so it is set twice: once
# server-side and once as NEXT_PUBLIC_* for the subscribe call in the client.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
# Must be a mailto: or https: URL — push services reject a missing subject.
VAPID_SUBJECT="mailto:you@example.com"

# --- Cron security ---
# The scheduler sends "Authorization: Bearer <CRON_SECRET>" to /api/cron/dispatch
# every minute. Any long random string. See DEPLOY.md for the Supabase pg_cron SQL.
CRON_SECRET="change-me-to-a-long-random-string"

# --- Not normally set ---
# The UI and the API are the same origin, so the client uses relative paths. Set this
# only if the API is ever served from somewhere else.
# NEXT_PUBLIC_API_URL=""
#
# The build id (NEXT_PUBLIC_BUILD_ID / APP_BUILD_ID), which drives the "a new version
# is available" check, is derived in next.config.ts — from the commit SHA on Vercel,
# from the clock locally. Nothing to set.
#
# Set to 0 to stop the app queueing changes made offline. Reading offline is unaffected
# — that is why the two shipped separately, so a sync problem costs the newer half and
# not the app's ability to open with no signal. On by default.
# NEXT_PUBLIC_OFFLINE_WRITES="0"
