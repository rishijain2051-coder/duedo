generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/// One account.
///
/// Two kinds, chosen at signup (`accountType`):
///   solo   — one person; every reminder is personal and private.
///   family — the same, plus membership of one or more families, each with a
///            shared reminder list all its members can see.
///
/// Preferences live here rather than in a global settings row precisely because
/// they are per-person — one user's timezone, default time, delivery channels and
/// inactivity timeout say nothing about anyone else's.
model User {
  id            String  @id @default(uuid())
  name          String
  email         String  @unique
  password_hash String? // bcrypt hash of the login PIN; null until first sign-in
  role          String  @default("member") // 'admin' or 'member'

  /// The install's owner. Exactly one account holds it, and it is the one thing no
  /// other admin can touch: the root row cannot be demoted, rejected, deleted, or
  /// have its PIN reset by anyone else. That is what makes it safe for there to be
  /// no "first account becomes admin" special case — the install can't be captured
  /// by whoever registers first, and it can't be locked out by an admin it promoted.
  ///
  /// Held as a flag rather than derived from "earliest admin" so it can be handed
  /// over deliberately (see makeRoot in app/api/users/[id]/route.ts) instead of
  /// being an accident of row order.
  isRootAdmin Boolean @default(false)

  /// pending | active | rejected.
  ///
  /// Anyone can self-register. Clicking the link in the verification email is what
  /// activates the account — no admin involved, because proving you can read the
  /// address is the thing worth checking, and an admin approving a name they don't
  /// recognise was never really a check at all.
  ///
  /// An admin can still activate or reject an account by hand, which is the fallback
  /// when mail is misconfigured or a link never arrives. Nothing is auto-activated:
  /// a fresh install's first admin is promoted by hand once (see DEPLOY.md), because
  /// the alternative — granting admin to whoever registers first — is a real capture
  /// window in exchange for saving one SQL statement.
  status String @default("pending")

  /// When the address was proved. Separate from `status` on purpose: an admin can
  /// activate an account without the address ever being verified, and that difference
  /// is worth being able to see.
  emailVerifiedAt DateTime? @db.Timestamptz

  /// HMAC of the outstanding verification token, never the token itself — it is a
  /// bearer credential that activates an account, so a database leak must not hand
  /// out working links. One at a time: requesting a new one invalidates the old.
  verifyTokenHash   String?
  verifyTokenSentAt DateTime? @db.Timestamptz

  /// Declared intent: `solo` hides every family surface in the UI. Actual
  /// membership lives in FamilyMember, so this only controls what is offered —
  /// which is what makes converting either way a one-field change.
  accountType String @default("solo") // solo | family

  phone String? // optional, reserved for future SMS/WhatsApp channels

  // ---------------------------------------------------------- preferences
  /// Every instant is stored UTC and rendered in this zone.
  timezone          String @default("Asia/Kolkata")
  /// HH:mm local, applied when a reminder carries no explicit time.
  defaultTime       String @default("05:30")
  /// While overdue, re-notify this often until completed or snoozed.
  overdueRepeatMins Int    @default(60)
  /// Sign out after this many minutes without a request. 0 disables it.
  idleTimeoutMins   Int    @default(0)

  /// Delivery channels — each user chooses how they want to be reminded.
  /// Both can be on; both can be off (in-app feed still records everything).
  emailOptIn Boolean @default(true)
  pushOptIn  Boolean @default(true)

  approvedAt DateTime? @db.Timestamptz
  createdAt  DateTime  @default(now()) @db.Timestamptz
  updatedAt  DateTime  @updatedAt @db.Timestamptz

  reminders         Reminder[]
  assignedReminders Reminder[]         @relation("AssignedReminders")
  categories        Category[]
  notifications     Notification[]
  activities        ActivityLog[]
  sessions          Session[]
  passkeys          Passkey[]
  pushDevices       PushSubscription[]
  families          FamilyMember[]
  dispatches        ReminderDispatch[]
  completedHistory  ReminderHistory[]  @relation("CompletedReminders")

  @@index([status])
}

/// A household. Owns a shared reminder list and its own category list.
///
/// There is no `headId` here: the head is the member whose FamilyMember.role is
/// "head". A denormalised pointer would only be a second source of truth to keep
/// in sync with the membership row.
model Family {
  id   String @id @default(uuid())
  name String

  /// Short, human-shareable code used to join. Rotatable by the head, so a code
  /// that has leaked can be retired without dissolving the family.
  joinCode String @unique

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  members    FamilyMember[]
  reminders  Reminder[]
  categories Category[]
}

/// Membership is many-to-many: a person can belong to several families at once
/// (their own household and their parents', say). Consequently there is no
/// `User.familyId`, and every scope check is `familyId IN (…)` rather than an
/// equality — see familyIdsFor() in lib/families.ts, which is the only sanctioned
/// way to obtain that set.
model FamilyMember {
  id       String   @id @default(uuid())
  familyId String
  family   Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role     String   @default("member") // head | member
  joinedAt DateTime @default(now()) @db.Timestamptz

  @@unique([familyId, userId])
  @@index([userId])
  @@index([familyId, role])
}

/// There is no join-request model. Entering a valid code creates the FamilyMember
/// row directly — see app/api/families/join/route.ts for why the approval step was
/// removed and what the head's controls are instead.

/// One row per active login, which is what makes sessions listable and
/// revocable. The cookie is still a signed token, but it now names a row here —
/// deleting the row kills the login immediately, which a purely stateless token
/// could never do.
model Session {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// SHA-256 of the cookie value. Hashed so a database leak doesn't hand over
  /// usable credentials, the same reasoning as the PIN.
  tokenHash String @unique

  label      String? // "iPhone · Safari"
  userAgent  String?
  createdAt  DateTime @default(now()) @db.Timestamptz
  /// Bumped (at most once a minute) on each authenticated request; drives the
  /// inactivity timeout.
  lastSeenAt DateTime @default(now()) @db.Timestamptz
  expiresAt  DateTime @db.Timestamptz

  @@index([userId])
  @@index([expiresAt])
}

/// A registered WebAuthn credential (Face ID / Touch ID / Windows Hello). The PIN
/// stays as the fallback, so this table may be empty for any user.
model Passkey {
  id     String @id // base64url credential ID
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  publicKey  String // base64url-encoded COSE public key
  counter    Int       @default(0)
  deviceType String?
  backedUp   Boolean   @default(false)
  transports String? // comma-separated
  label      String?
  createdAt  DateTime  @default(now()) @db.Timestamptz
  lastUsedAt DateTime? @db.Timestamptz

  @@index([userId])
}

/// One row per browser/device that has granted notification permission, owned by
/// whoever was signed in when it was granted. On iOS this only exists for the app
/// installed to the Home Screen.
model PushSubscription {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Globally unique, not unique-per-user: a browser has one push endpoint, so if
  /// a second person signs in on the same device the row is reassigned to them.
  /// That is the correct outcome — otherwise they would receive each other's
  /// private reminders.
  endpoint  String    @unique
  p256dh    String
  auth      String
  label     String?
  createdAt DateTime  @default(now()) @db.Timestamptz
  lastOkAt  DateTime? @db.Timestamptz
  failures  Int       @default(0) // consecutive send failures; pruned once the endpoint is gone

  /// Set when this device is revoked from the Settings page. The row is kept
  /// rather than deleted so the block survives: the app re-registers itself on
  /// every load, and a deleted row would simply come back. Only an explicit
  /// "enable notifications" on the device itself clears this.
  blockedAt DateTime? @db.Timestamptz

  @@index([userId])
}

/// A category belongs to exactly one scope: a person (`userId`) or a family
/// (`familyId`). Both nullable, exactly one set — enforced in app code.
///
/// Two constraints rather than one because a member must be able to have a
/// personal "Bills" and a family "Bills" without collision. Postgres treats NULLs
/// as distinct, so a personal row can never collide on the family constraint or
/// the other way round.
model Category {
  id String @id @default(uuid())

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  familyId String?
  family   Family? @relation(fields: [familyId], references: [id], onDelete: Cascade)

  name      String
  icon      String?
  color     String?
  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  reminders Reminder[]

  @@unique([userId, name])
  @@unique([familyId, name])
  @@index([userId])
  @@index([familyId])
}

model Reminder {
  id String @id @default(uuid())

  /// The creator, and the owner of a personal reminder. Always set.
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// null = personal, private to userId. Set = on that family's shared list,
  /// visible to every member of it.
  familyId String?
  family   Family? @relation(fields: [familyId], references: [id], onDelete: Cascade)

  /// Who is responsible. Only meaningful on a family reminder.
  assignedToId String?
  assignedTo   User?   @relation("AssignedReminders", fields: [assignedToId], references: [id])

  /// Who gets alerted when it fires:
  ///   owner    — only the creator (the default, and the only valid value for a
  ///              personal reminder)
  ///   assignee — the assigned member, falling back to the creator
  ///   family   — every active member of familyId
  /// Resolved by lib/recipients.ts, which is the single place that decides.
  audience String @default("owner")

  title       String
  description String?
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id])
  priority    String   @default("normal") // low, normal, high
  status      String   @default("active") // draft, active, completed, archived

  /// Absolute instant the reminder is due. Always concrete — when the user omits
  /// a time we apply their defaultTime in their timezone before saving.
  dueAt   DateTime @db.Timestamptz
  /// False when the user never picked a time (we filled in the default). Display-only.
  hasTime Boolean  @default(true)

  /// Minutes before dueAt to send an advance alert. One alert per entry.
  /// e.g. [10080, 1440, 60] = a week, a day, and an hour before.
  leadOffsets Int[] @default([])

  recurrenceRule String? // One Time, Daily, Weekly, Monthly, Quarterly, Half-Yearly, Yearly
  amount         Float?  @default(0)

  /// Suppresses all alerts until this instant (set by the Snooze action).
  snoozedUntil DateTime? @db.Timestamptz
  /// Last overdue nag. A fact about the reminder's cycle, not about any one
  /// recipient, so it stays here; per-person email throttling lives on
  /// ReminderDispatch.emailedAt instead.
  lastNaggedAt DateTime? @db.Timestamptz
  completedAt  DateTime? @db.Timestamptz

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  history    ReminderHistory[]
  dispatches ReminderDispatch[]

  @@index([userId, status, dueAt])
  @@index([familyId, status, dueAt])
  @@index([status, dueAt])
  @@index([assignedToId])
}

model ReminderHistory {
  id         String   @id @default(uuid())
  reminderId String
  reminder   Reminder @relation(fields: [reminderId], references: [id], onDelete: Cascade)

  /// Who marked it done — worth knowing on a shared family list. SetNull rather
  /// than Cascade: deleting an account shouldn't erase the family's payment history.
  completedById String?
  completedBy   User?   @relation("CompletedReminders", fields: [completedById], references: [id], onDelete: SetNull)

  completedOn DateTime @default(now()) @db.Timestamptz
  amount      Float?
  status      String
  remarks     String?

  @@index([reminderId])
}

/// One row per alert actually sent to one person, which is how the dispatcher
/// avoids sending the same thing twice. Keyed on cycleDueAt so a recurring
/// reminder re-arms cleanly the moment its dueAt rolls forward.
///
/// `userId` is in the unique key because a family reminder has several
/// recipients: without it, the first person's row would suppress everybody
/// else's alert for that fire.
model ReminderDispatch {
  id         String   @id @default(uuid())
  reminderId String
  reminder   Reminder @relation(fields: [reminderId], references: [id], onDelete: Cascade)
  /// The recipient this row is about.
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  cycleDueAt DateTime  @db.Timestamptz // the dueAt this fire belongs to
  kind       String // lead | due | overdue
  /// lead: the offset in minutes. due: 0. overdue: whole minutes since cycleDueAt,
  /// which is unique per minute and so dedupes naturally against a per-minute cron.
  offsetMin  Int
  firedAt    DateTime  @default(now()) @db.Timestamptz
  ok         Boolean   @default(true)
  /// Set when this recipient was emailed. The 12h overdue-email throttle reads the
  /// newest of these per (reminderId, userId), which makes the throttle per person
  /// rather than per household.
  emailedAt  DateTime? @db.Timestamptz

  @@unique([reminderId, userId, cycleDueAt, kind, offsetMin])
  @@index([reminderId])
  @@index([reminderId, userId, emailedAt])
}

/// In-app notification feed. Survives even when a push or email fails to deliver,
/// so a missed notification still leaves a record.
model Notification {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  reminderId String?
  title      String
  body       String
  kind       String   @default("due") // lead | due | overdue
  read       Boolean  @default(false)
  createdAt  DateTime @default(now()) @db.Timestamptz

  @@index([userId, read, createdAt])
  @@index([reminderId])
}

/// One dispatch tick. The cron used to return a summary and persist nothing, so
/// "is delivery working?" was unanswerable after the fact — which is what the
/// admin health page needs to show. Pruned to the most recent rows by the
/// dispatcher itself.
model DispatchRun {
  id           String   @id @default(uuid())
  ranAt        DateTime @default(now()) @db.Timestamptz
  durationMs   Int
  considered   Int
  recipients   Int
  firedLead    Int      @default(0)
  firedDue     Int      @default(0)
  firedOverdue Int      @default(0)
  pushesSent   Int      @default(0)
  pushesFailed Int      @default(0)
  emailsSent   Int      @default(0)
  error        String?

  @@index([ranAt])
}

/// Audit trail. Written by lib/audit.ts on approvals, role changes, deletions,
/// family membership changes, and every admin read of another account's data.
model ActivityLog {
  id      String  @id @default(uuid())
  /// Who did it. Null for system actions (the dispatcher, say).
  actorId String?
  actor   User?   @relation(fields: [actorId], references: [id], onDelete: SetNull)

  action    String // user.approve | family.join.approve | admin.read.reminders | …
  entity    String // user | family | reminder | session
  entityId  String?
  detail    Json?
  timestamp DateTime @default(now()) @db.Timestamptz

  @@index([actorId])
  @@index([timestamp])
  @@index([entity, entityId])
}
