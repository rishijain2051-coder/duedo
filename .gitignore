# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (real env is ignored; the example is committed)
.env*
!.env.example

# vercel
.vercel

# agent tooling — local to whoever is working on the repo, not project config.
# .claude/launch.json is kept, since it just describes how to run the dev server.
/.agents/
/agent/
/.claude/skills/
/skills-lock.json

# typescript
*.tsbuildinfo
next-env.d.ts

# Generated by scripts/make-shortcut.mjs. Carries a live API key when one is passed,
# so it must never be committed — the generator is the thing worth keeping, not its
# output.
*.shortcut
